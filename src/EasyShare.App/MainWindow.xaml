<wpfui:FluentWindow x:Class="EasyShare.App.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:converters="clr-namespace:EasyShare.App.Converters"
  xmlns:views="clr-namespace:EasyShare.App.Views"
  Title="EasyShare"
  Width="920" Height="660"
  MinWidth="720" MinHeight="520"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="Mica"
  Closing="Window_Closing">

  <wpfui:FluentWindow.Resources>
    <converters:DeviceTypeToIconConverter x:Key="DeviceTypeToIcon" />
    <converters:TransferStatusToColorConverter x:Key="StatusToColor" />

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <DataTemplate x:Key="DeviceTemplate">
      <Border x:Name="DeviceCard" Background="#1e1e1e" CornerRadius="6" Padding="10,8" Margin="0,0,0,4"
              BorderBrush="#333333" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="DeviceCard_Click">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding DeviceType, Converter={StaticResource DeviceTypeToIcon}}"
                       FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" FontSize="14"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="SelectedIndicator" Text=" &lt;" FontSize="12" Foreground="#4ade80"
                       Visibility="Collapsed" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="{Binding DeviceModel}" FontSize="11" Foreground="Gray" Margin="24,2,0,0"/>
          <TextBlock Text="{Binding IpAddress}" FontSize="11" Foreground="Gray" Margin="24,0,0,0"/>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="TransferTemplate">
      <Border Background="#1e1e1e" CornerRadius="6" Padding="10,8" Margin="0,0,0,4"
              BorderBrush="#333333" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="Medium"
                     TextTrimming="CharacterEllipsis"/>
          <ProgressBar Value="{Binding Progress}" Height="6" Margin="0,4,0,2"
                       Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"/>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding SpeedText}" FontSize="11" Foreground="Gray" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding StatusText}" FontSize="11"
                       Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="HistoryTemplate">
      <Border Background="transparent" CornerRadius="4" Padding="8,4" Margin="0,0,0,2">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Direction}" FontSize="11" Foreground="Gray" Width="16"/>
          <TextBlock Text="{Binding FileName}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="4,0"/>
          <TextBlock Text="{Binding Timestamp, StringFormat=\{0:HH:mm\}}" FontSize="10" Foreground="Gray" Margin="8,0,0,0"/>
        </StackPanel>
      </Border>
    </DataTemplate>
  </wpfui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <wpfui:TitleBar Grid.Column="0" Title="EasyShare"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Top">
        <Button x:Name="QrButton" Content="QR-Empfang" Padding="10,4" Margin="0,6,4,0" Click="QrButton_Click" ToolTip="QR-Code für Zero-Install Empfang anzeigen"/>
        <Button x:Name="SettingsButton" Content="Einstellungen" Padding="10,4" Margin="0,6,0,0" Click="SettingsButton_Click" ToolTip="Einstellungen öffnen"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="8,0,8,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Margin="0,0,8,0">
        <TextBlock Text="Geräte in der Nähe" FontSize="16" FontWeight="SemiBold" Margin="4,0,4,8"/>
        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="DeviceList" ItemTemplate="{StaticResource DeviceTemplate}"/>
        </ScrollViewer>

        <TextBlock x:Name="SelectedDeviceText" Text="Kein Zielgerät ausgewählt" FontSize="12"
                   Foreground="#fbbf24" Margin="4,8,4,8" TextWrapping="Wrap"/>

        <Separator Margin="4,4"/>
        <TextBlock Text="Aktive Übertragungen" FontSize="16" FontWeight="SemiBold" Margin="4,0,4,8"/>
        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="TransferList" ItemTemplate="{StaticResource TransferTemplate}"/>
        </ScrollViewer>

        <Separator Margin="4,4"/>
        <TextBlock Text="Verlauf" FontSize="14" FontWeight="SemiBold" Margin="4,0,4,8"/>
        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="HistoryList" ItemTemplate="{StaticResource HistoryTemplate}"/>
        </ScrollViewer>
      </StackPanel>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" x:Name="DropZone"
                BorderBrush="#555555" BorderThickness="2" CornerRadius="8"
                Background="#1e1e1e" Padding="32"
                AllowDrop="True" Drop="DropZone_Drop" Margin="4">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Dateien hier ablegen" FontSize="20" FontWeight="SemiBold"
                       Foreground="Gray" HorizontalAlignment="Center"/>
            <TextBlock Text="oder per Rechtsklick im Explorer teilen" FontSize="12"
                       Foreground="LightGray" HorizontalAlignment="Center" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,8">
          <Button x:Name="SelectFilesButton" Content="Dateien auswählen..."
                  Padding="16,6" Click="SelectFilesButton_Click"/>
          <TextBlock x:Name="StatusText" Text="Bereit" Foreground="Gray"
                     VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</wpfui:FluentWindow>
