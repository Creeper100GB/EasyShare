<wpfui:FluentWindow x:Class="EasyShare.App.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:converters="clr-namespace:EasyShare.App.Converters"
  xmlns:views="clr-namespace:EasyShare.App.Views"
  xmlns:loc="clr-namespace:EasyShare.App.Localization"
  xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
  Title="{Binding [App.Title], Source={x:Static loc:Loc.Instance}}"
  Width="920" Height="660"
  MinWidth="720" MinHeight="520"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="Mica"
  Closing="Window_Closing">

  <wpfui:FluentWindow.Resources>
    <converters:DeviceTypeToIconConverter x:Key="DeviceTypeToIcon" />
    <converters:TransferStatusToColorConverter x:Key="StatusToColor" />

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <Style x:Key="VibrantProgressBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="18"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid ClipToBounds="True">
              <Border CornerRadius="9" Background="{DynamicResource ProgressBarTrack}"/>
              <Border x:Name="PART_Indicator" CornerRadius="9"
                      HorizontalAlignment="Left" ClipToBounds="True">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{DynamicResource AccentGradient1Color}" Offset="0.0"/>
                    <GradientStop Color="{DynamicResource AccentGradient2Color}" Offset="0.25"/>
                    <GradientStop Color="{DynamicResource AccentGradient3Color}" Offset="0.5"/>
                    <GradientStop Color="{DynamicResource AccentGradient4Color}" Offset="0.75"/>
                    <GradientStop Color="{DynamicResource AccentGradient5Color}" Offset="1.0"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="DeviceTemplate">
      <Border x:Name="DeviceCard" CornerRadius="6" Padding="10,8" Margin="0,0,0,4"
              Cursor="Hand" MouseLeftButtonUp="DeviceCard_Click">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevated}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource SuccessColor}"/>
                <Setter Property="BorderThickness" Value="2.5"/>
                <Setter Property="Background" Value="{DynamicResource SuccessSurface}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding DeviceType, Converter={StaticResource DeviceTypeToIcon}}"
                       FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" FontSize="14"
                       VerticalAlignment="Center"/>
            <TextBlock Text="&#x2713;" FontSize="12" Foreground="{DynamicResource SuccessColor}"
                       Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                       VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="{Binding DeviceModel}" FontSize="11" Foreground="Gray" Margin="24,2,0,0"/>
          <TextBlock Text="{Binding IpAddress}" FontSize="11" Foreground="Gray" Margin="24,0,0,0"/>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="TransferTemplate">
      <Border Background="{DynamicResource SurfaceElevated}" CornerRadius="6" Padding="12,10" Margin="0,0,0,6"
              BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="Medium"
                       TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
            <ProgressBar Value="{Binding Progress}" Style="{StaticResource VibrantProgressBar}"
                         Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Progress, StringFormat=\{0:P0\}}" FontSize="11" 
                         FontWeight="SemiBold" Foreground="{DynamicResource AccentGradient2}" Margin="0,0,10,0"/>
              <TextBlock Text="{Binding SpeedText}" FontSize="11" Foreground="Gray" Margin="0,0,10,0"/>
              <TextBlock Text="{Binding StatusText}" FontSize="11"
                         Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"/>
            </StackPanel>
          </StackPanel>
          <Button Grid.Column="1" Content="{Binding [Transfer.Cancel], Source={x:Static loc:Loc.Instance}}"
                  FontSize="11" Padding="10,4" Margin="10,0,0,0" VerticalAlignment="Center"
                  Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"
                  Click="CancelTransfer_Click"/>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="HistoryTemplate">
      <Border Background="transparent" CornerRadius="4" Padding="8,4" Margin="0,0,0,2">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Direction}" FontSize="11" Foreground="Gray" Width="16"/>
          <TextBlock Text="{Binding FileName}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="4,0"/>
          <TextBlock Text="{Binding Timestamp, StringFormat=\{0:HH:mm\}}" FontSize="10" Foreground="Gray" Margin="8,0,0,0"/>
        </StackPanel>
      </Border>
    </DataTemplate>
  </wpfui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <wpfui:TitleBar Title="{Binding [App.Title], Source={x:Static loc:Loc.Instance}}"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                  VerticalAlignment="Top" Margin="0,6,150,0"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="QrButton" Content="{Binding [Main.QrButton], Source={x:Static loc:Loc.Instance}}" Padding="10,4" Margin="0,0,4,0" Click="QrButton_Click" ToolTip="{Binding [Main.QrButtonTooltip], Source={x:Static loc:Loc.Instance}}"/>
        <Button x:Name="SettingsButton" Content="{Binding [Main.SettingsButton], Source={x:Static loc:Loc.Instance}}" Padding="10,4" Click="SettingsButton_Click" ToolTip="{Binding [Main.SettingsButtonTooltip], Source={x:Static loc:Loc.Instance}}"/>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" x:Name="UpdateBanner" Visibility="Collapsed"
            Background="{DynamicResource InfoBackground}" Padding="12,8" Margin="8,0,8,0" CornerRadius="6"
            BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="{Binding [Main.UpdateAvailable], Source={x:Static loc:Loc.Instance}}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InfoText}"/>
          <TextBlock x:Name="UpdateVersionText" FontSize="11" Foreground="{DynamicResource InfoText}" Opacity="0.7"/>
        </StackPanel>
        <Button Grid.Column="1" x:Name="UpdateButton" Content="{Binding [Main.UpdateButton], Source={x:Static loc:Loc.Instance}}" Padding="12,4"
                Click="UpdateButton_Click" FontSize="12"/>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="8,0,8,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Margin="0,0,8,0">
        <TextBlock Text="{Binding [Main.DevicesHeader], Source={x:Static loc:Loc.Instance}}" FontSize="16" FontWeight="SemiBold" Margin="4,0,4,8"/>
        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="DeviceList" ItemTemplate="{StaticResource DeviceTemplate}"/>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" Margin="4,8,4,8">
          <TextBlock x:Name="SelectedDeviceText" FontSize="12"
                     Foreground="{DynamicResource WarningColor}" TextWrapping="Wrap"/>
          <Button x:Name="DeselectButton" Content="{Binding [Main.Deselect], Source={x:Static loc:Loc.Instance}}"
                  FontSize="11" Padding="8,2" Margin="8,0,0,0" Click="DeselectButton_Click"
                  Visibility="Collapsed"/>
        </StackPanel>

        <Separator Margin="4,4"/>
        <TextBlock Text="{Binding [Main.TransferHeader], Source={x:Static loc:Loc.Instance}}" FontSize="16" FontWeight="SemiBold" Margin="4,0,4,8"/>
        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="TransferList" ItemTemplate="{StaticResource TransferTemplate}"/>
        </ScrollViewer>

        <Separator Margin="4,4"/>
        <TextBlock Text="{Binding [Main.HistoryHeader], Source={x:Static loc:Loc.Instance}}" FontSize="14" FontWeight="SemiBold" Margin="4,0,4,8"/>
        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="HistoryList" ItemTemplate="{StaticResource HistoryTemplate}"/>
        </ScrollViewer>
      </StackPanel>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" x:Name="DropZone"
                BorderBrush="{DynamicResource DropZoneBorder}" BorderThickness="2" CornerRadius="12"
                Background="{DynamicResource DropZoneBackground}" Padding="32"
                AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver" Margin="4">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="&#x1F4E4;" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock Text="{Binding [Main.DropZone], Source={x:Static loc:Loc.Instance}}" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextHint}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding [Main.DropZoneHint], Source={x:Static loc:Loc.Instance}}" FontSize="12"
                       Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,8">
          <Button x:Name="SelectFilesButton" Content="{Binding [Main.SelectFiles], Source={x:Static loc:Loc.Instance}}"
                  Padding="16,6" Click="SelectFilesButton_Click"/>
          <CheckBox x:Name="CompressCheckBox" Content="{Binding [Main.Compress], Source={x:Static loc:Loc.Instance}}"
                    Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="{Binding [Main.CompressTooltip], Source={x:Static loc:Loc.Instance}}"/>
          <CheckBox x:Name="ScanCheckBox" Content="{Binding [Main.Scan], Source={x:Static loc:Loc.Instance}}"
                    Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="{Binding [Main.ScanTooltip], Source={x:Static loc:Loc.Instance}}"/>
          <TextBlock x:Name="StatusText" Text="{Binding [Main.StatusReady], Source={x:Static loc:Loc.Instance}}" Foreground="Gray"
                     VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</wpfui:FluentWindow>
