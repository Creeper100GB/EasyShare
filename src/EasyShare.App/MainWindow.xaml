<wpfui:FluentWindow x:Class="EasyShare.App.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:converters="clr-namespace:EasyShare.App.Converters"
  Title="EasyShare"
  Width="900" Height="650"
  MinWidth="700" MinHeight="500"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="Mica"
  Closing="Window_Closing">

  <wpfui:FluentWindow.Resources>
    <converters:DeviceTypeToIconConverter x:Key="DeviceTypeToIcon" />
    <converters:TransferStatusToColorConverter x:Key="StatusToColor" />

    <DataTemplate x:Key="DeviceTemplate">
      <Border Background="#1e1e1e" CornerRadius="6" Padding="10,8" Margin="0,0,0,4"
              BorderBrush="#333333" BorderThickness="1">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding DeviceType, Converter={StaticResource DeviceTypeToIcon}}"
                       FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" FontSize="14"
                       VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="{Binding DeviceModel}" FontSize="11" Foreground="Gray" Margin="24,2,0,0"/>
          <TextBlock Text="{Binding IpAddress}" FontSize="11" Foreground="Gray" Margin="24,0,0,0"/>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="TransferTemplate">
      <Border Background="#1e1e1e" CornerRadius="6" Padding="10,8" Margin="0,0,0,4"
              BorderBrush="#333333" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="Medium"
                     TextTrimming="CharacterEllipsis"/>
          <ProgressBar Value="{Binding Progress}" Height="6" Margin="0,4,0,2"
                       Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"/>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding SpeedText}" FontSize="11" Foreground="Gray" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="Gray"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </wpfui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <wpfui:TitleBar Grid.Row="0" Title="EasyShare"/>

    <Grid Grid.Row="1" Margin="8,0,8,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Margin="0,0,8,0">
        <TextBlock Text="Geräte in der Nähe" FontSize="16" FontWeight="SemiBold" Margin="4,0,4,8"/>
        <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="DeviceList" ItemTemplate="{StaticResource DeviceTemplate}"/>
        </ScrollViewer>
        <Separator Margin="4,8"/>
        <TextBlock Text="Aktive Übertragungen" FontSize="16" FontWeight="SemiBold" Margin="4,0,4,8"/>
        <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="TransferList" ItemTemplate="{StaticResource TransferTemplate}"/>
        </ScrollViewer>
      </StackPanel>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" x:Name="DropZone"
                BorderBrush="#555555" BorderThickness="2" CornerRadius="8"
                Background="#1e1e1e" Padding="32"
                AllowDrop="True" Drop="DropZone_Drop" Margin="4">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Dateien hier ablegen" FontSize="20" FontWeight="SemiBold"
                       Foreground="Gray" HorizontalAlignment="Center"/>
            <TextBlock Text="oder per Rechtsklick im Explorer teilen" FontSize="12"
                       Foreground="LightGray" HorizontalAlignment="Center" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,8">
          <Button x:Name="SelectFilesButton" Content="Dateien auswählen..."
                  Padding="16,6" Click="SelectFilesButton_Click"/>
          <TextBlock x:Name="StatusText" Text="Bereit" Foreground="Gray"
                     VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</wpfui:FluentWindow>
