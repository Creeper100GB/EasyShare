<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EasyShare.Core\EasyShare.Core.csproj" />
    <ProjectReference Include="..\EasyShare.Transport\EasyShare.Transport.csproj" />
    <ProjectReference Include="..\EasyShare.Shell\EasyShare.Shell.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="wpf-ui" Version="3.0.5" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <TargetPlatform>windows</TargetPlatform>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\app_icon.ico</ApplicationIcon>
    <AssemblyName>EasyShare</AssemblyName>
    <Product>EasyShare</Product>
    <Description>Native Windows file sharing - LocalSend compatible</Description>
    <Company>EasyShare</Company>
    <Version>2.4.0</Version>
    <Copyright>2026</Copyright>
    <PackageId>EasyShare</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Resources\app_icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Resources\Lang\*.json" />
  </ItemGroup>

</Project>
