<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="AccentGradient1Color">#6366f1</Color>
  <Color x:Key="AccentGradient2Color">#a855f7</Color>
  <Color x:Key="AccentGradient3Color">#ec4899</Color>
  <Color x:Key="AccentGradient4Color">#f97316</Color>
  <Color x:Key="AccentGradient5Color">#fbbf24</Color>

  <SolidColorBrush x:Key="SurfaceBackground" Color="#f5f6f8"/>
  <SolidColorBrush x:Key="SurfaceElevated" Color="#ffffff"/>
  <SolidColorBrush x:Key="SurfaceElevatedAlt" Color="#f3f4f6"/>
  <SolidColorBrush x:Key="BorderColor" Color="#d1d5db"/>
  <SolidColorBrush x:Key="TextPrimary" Color="#111827"/>
  <SolidColorBrush x:Key="TextSecondary" Color="#6b7280"/>
  <SolidColorBrush x:Key="TextHint" Color="#64748b"/>
  <SolidColorBrush x:Key="AccentPrimary" Color="#4f46e5"/>
  <SolidColorBrush x:Key="AccentGradient1" Color="{StaticResource AccentGradient1Color}"/>
  <SolidColorBrush x:Key="AccentGradient2" Color="{StaticResource AccentGradient2Color}"/>
  <SolidColorBrush x:Key="AccentGradient3" Color="{StaticResource AccentGradient3Color}"/>
  <SolidColorBrush x:Key="AccentGradient4" Color="{StaticResource AccentGradient4Color}"/>
  <SolidColorBrush x:Key="AccentGradient5" Color="{StaticResource AccentGradient5Color}"/>
  <SolidColorBrush x:Key="SuccessColor" Color="#16a34a"/>
  <SolidColorBrush x:Key="SuccessSurface" Color="#dcfce7"/>
  <SolidColorBrush x:Key="ErrorColor" Color="#dc2626"/>
  <SolidColorBrush x:Key="WarningColor" Color="#b45309"/>
  <SolidColorBrush x:Key="ProgressBarTrack" Color="#e5e7eb"/>
  <SolidColorBrush x:Key="InfoBackground" Color="#dbeafe"/>
  <SolidColorBrush x:Key="InfoBorder" Color="#3b82f6"/>
  <SolidColorBrush x:Key="InfoText" Color="#1e40af"/>
  <SolidColorBrush x:Key="DropZoneBackground" Color="#f8fafc"/>
  <SolidColorBrush x:Key="DropZoneBorder" Color="#94a3b8"/>

</ResourceDictionary>
