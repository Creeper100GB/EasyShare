<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="AccentGradient1Color">#6366f1</Color>
  <Color x:Key="AccentGradient2Color">#a855f7</Color>
  <Color x:Key="AccentGradient3Color">#ec4899</Color>
  <Color x:Key="AccentGradient4Color">#f97316</Color>
  <Color x:Key="AccentGradient5Color">#fbbf24</Color>

  <SolidColorBrush x:Key="SurfaceBackground" Color="#0f0f0f"/>
  <SolidColorBrush x:Key="SurfaceElevated" Color="#1e1e1e"/>
  <SolidColorBrush x:Key="SurfaceElevatedAlt" Color="#1a1a1a"/>
  <SolidColorBrush x:Key="BorderColor" Color="#333333"/>
  <SolidColorBrush x:Key="TextPrimary" Color="#e5e5e5"/>
  <SolidColorBrush x:Key="TextSecondary" Color="#666666"/>
  <SolidColorBrush x:Key="TextHint" Color="#aaaaaa"/>
  <SolidColorBrush x:Key="AccentPrimary" Color="#6366f1"/>
  <SolidColorBrush x:Key="AccentGradient1" Color="{StaticResource AccentGradient1Color}"/>
  <SolidColorBrush x:Key="AccentGradient2" Color="{StaticResource AccentGradient2Color}"/>
  <SolidColorBrush x:Key="AccentGradient3" Color="{StaticResource AccentGradient3Color}"/>
  <SolidColorBrush x:Key="AccentGradient4" Color="{StaticResource AccentGradient4Color}"/>
  <SolidColorBrush x:Key="AccentGradient5" Color="{StaticResource AccentGradient5Color}"/>
  <SolidColorBrush x:Key="SuccessColor" Color="#4ade80"/>
  <SolidColorBrush x:Key="SuccessSurface" Color="#1a2b22"/>
  <SolidColorBrush x:Key="ErrorColor" Color="#f87171"/>
  <SolidColorBrush x:Key="WarningColor" Color="#fbbf24"/>
  <SolidColorBrush x:Key="ProgressBarTrack" Color="#2a2a2a"/>
  <SolidColorBrush x:Key="InfoBackground" Color="#1e3a5f"/>
  <SolidColorBrush x:Key="InfoBorder" Color="#2563eb"/>
  <SolidColorBrush x:Key="InfoText" Color="#93c5fd"/>
  <SolidColorBrush x:Key="DropZoneBackground" Color="#161616"/>
  <SolidColorBrush x:Key="DropZoneBorder" Color="#444444"/>

</ResourceDictionary>
