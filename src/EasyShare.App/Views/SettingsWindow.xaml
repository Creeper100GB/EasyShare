<wpfui:FluentWindow x:Class="EasyShare.App.Views.SettingsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Einstellungen" Width="500" Height="600"
  WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <wpfui:TitleBar Grid.Row="0" Title="Einstellungen"/>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
      <StackPanel>
        <TextBlock Text="Gerät" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <StackPanel Margin="8,0,0,16">
          <TextBlock Text="Gerätename" FontSize="12" Foreground="Gray"/>
          <TextBox x:Name="AliasTextBox" Margin="0,4,0,12"/>
          <TextBlock Text="Port" FontSize="12" Foreground="Gray"/>
          <TextBox x:Name="PortBox" Text="53317" Margin="0,4,0,12"/>
        </StackPanel>

        <Separator/>

        <TextBlock Text="Übertragung" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,8"/>
        <StackPanel Margin="8,0,0,16">
          <TextBlock Text="Speicherort für empfangene Dateien" FontSize="12" Foreground="Gray"/>
          <Grid Margin="0,4,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SavePathTextBox" Grid.Column="0" Margin="0,0,4,0"/>
            <Button Grid.Column="1" Content="..." Padding="8,0" Click="BrowseSavePath_Click"/>
          </Grid>
          <CheckBox x:Name="AutoAcceptCheckBox" Content="Dateien von vertrauten Geräten automatisch annehmen" Margin="0,0,0,12"/>
          <TextBlock Text="Geschwindigkeitslimit" FontSize="12" Foreground="Gray" Margin="0,8,0,4"/>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="SpeedLimitSlider" Grid.Column="0" Minimum="0" Maximum="100" Value="0"
                    TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="SpeedLimitSlider_ValueChanged"/>
            <TextBlock x:Name="SpeedLimitText" Grid.Column="1" Text="Unbegrenzt" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"/>
          </Grid>
        </StackPanel>

        <Separator/>

        <TextBlock Text="Erscheinungsbild" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,8"/>
        <StackPanel Margin="8,0,0,16">
          <TextBlock Text="Design" FontSize="12" Foreground="Gray"/>
          <ComboBox x:Name="ThemeComboBox" Margin="0,4,0,12" SelectionChanged="ThemeComboBox_SelectionChanged">
            <ComboBoxItem Content="Hell"/>
            <ComboBoxItem Content="Dunkel"/>
            <ComboBoxItem Content="Automatisch" IsSelected="True"/>
          </ComboBox>
        </StackPanel>

        <Separator/>

        <TextBlock Text="System" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,8"/>
        <StackPanel Margin="8,0,0,16">
          <CheckBox x:Name="AutoStartCheckBox" Content="Automatisch beim Systemstart starten" Margin="0,0,0,12"/>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="ContextMenuButton" Content="Explorer-Kontextmenü registrieren" Padding="12,6" Click="ContextMenuButton_Click"/>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Schließen" Padding="16,6" Click="CloseButton_Click"/>
    </StackPanel>
  </Grid>
</wpfui:FluentWindow>
