<wpfui:FluentWindow x:Class="EasyShare.App.Views.ReceiveDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:loc="clr-namespace:EasyShare.App.Localization"
  Title="{Binding [Receive.Title], Source={x:Static loc:Loc.Instance}}"
  Width="420" Height="380"
  WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True"
  ResizeMode="NoResize" WindowStartupLocation="CenterOwner">

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <wpfui:TitleBar Grid.Row="0" Title="{Binding [Receive.Title], Source={x:Static loc:Loc.Instance}}"/>

    <TextBlock Grid.Row="1" x:Name="SenderText" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,4"/>

    <Border Grid.Row="2" Background="{DynamicResource SurfaceElevatedAlt}" CornerRadius="6" Padding="12" Margin="0,8,0,0"
            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" MaxHeight="180">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="FileList"/>
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="3" x:Name="TotalSizeText" FontSize="12" Foreground="Gray" Margin="0,8,0,0"/>

    <CheckBox Grid.Row="4" x:Name="TrustCheckBox"
              Content="{Binding [Receive.Trust], Source={x:Static loc:Loc.Instance}}"
              Margin="0,12,0,0" VerticalAlignment="Center"/>

    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="RejectButton"
              Content="{Binding [Receive.Reject], Source={x:Static loc:Loc.Instance}}"
              Padding="16,6" Margin="0,0,8,0" Click="Reject_Click"/>
      <Button x:Name="AcceptButton"
              Content="{Binding [Receive.Accept], Source={x:Static loc:Loc.Instance}}"
              Padding="16,6" Click="Accept_Click"/>
    </StackPanel>
  </Grid>
</wpfui:FluentWindow>
