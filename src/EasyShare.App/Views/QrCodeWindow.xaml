<wpfui:FluentWindow x:Class="EasyShare.App.Views.QrCodeWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:loc="clr-namespace:EasyShare.App.Localization"
  Title="{Binding [Qr.Title], Source={x:Static loc:Loc.Instance}}"
  Width="400" Height="480"
  WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True"
  ResizeMode="NoResize" WindowStartupLocation="CenterOwner">

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <wpfui:TitleBar Grid.Row="0" Title="{Binding [Qr.Title], Source={x:Static loc:Loc.Instance}}"/>

    <TextBlock Grid.Row="1"
               Text="{Binding [Qr.ScanHint], Source={x:Static loc:Loc.Instance}}"
               FontSize="14" Foreground="Gray" HorizontalAlignment="Center" Margin="0,12,0,16"/>

    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16" HorizontalAlignment="Center"
            VerticalAlignment="Center">
      <Image x:Name="QrImage" Width="240" Height="240" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
    </Border>

    <TextBlock Grid.Row="3" x:Name="UrlText" FontSize="12" Foreground="Gray"
               HorizontalAlignment="Center" Margin="0,16,0,4" TextWrapping="Wrap"/>

    <StackPanel Grid.Row="4" HorizontalAlignment="Center" Margin="0,4,0,8">
      <TextBlock Text="{Binding [Qr.ModeActive], Source={x:Static loc:Loc.Instance}}"
                 FontSize="13" FontWeight="SemiBold"
                 Foreground="{DynamicResource SuccessColor}" HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding [Qr.OpenUrl], Source={x:Static loc:Loc.Instance}}"
                 FontSize="11" Foreground="Gray" HorizontalAlignment="Center" Margin="0,2,0,0"/>
    </StackPanel>
  </Grid>
</wpfui:FluentWindow>
