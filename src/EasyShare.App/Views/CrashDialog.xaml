<wpfui:FluentWindow x:Class="EasyShare.App.Views.CrashDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:loc="clr-namespace:EasyShare.App.Localization"
  Title="{Binding [App.CrashTitle], Source={x:Static loc:Loc.Instance}}"
  Width="640" Height="420"
  WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True"
  ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <wpfui:TitleBar Grid.Row="0" Title="{Binding [App.CrashTitle], Source={x:Static loc:Loc.Instance}}"/>

    <Border Grid.Row="1" Background="{DynamicResource SurfaceElevatedAlt}" CornerRadius="6" Padding="12" Margin="0,12,0,0"
            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
      <TextBox x:Name="DetailsBox" IsReadOnly="True" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
               BorderThickness="0" Background="Transparent"
               Text="{Binding [App.CrashIntro], Source={x:Static loc:Loc.Instance}}"/>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Padding="16,6" Margin="0,0,8,0" Click="OpenLogs_Click"
              Content="Logs öffnen"/>
      <Button Padding="16,6" Margin="0,0,8,0" Click="Copy_Click"
              Content="{Binding [App.CrashCopy], Source={x:Static loc:Loc.Instance}}"/>
      <Button Padding="16,6" Margin="0,0,8,0" Click="Restart_Click"
              Content="{Binding [App.CrashRestart], Source={x:Static loc:Loc.Instance}}"/>
      <Button Padding="16,6" IsDefault="True" Click="Close_Click"
              Content="{Binding [App.CrashClose], Source={x:Static loc:Loc.Instance}}"/>
    </StackPanel>
  </Grid>
</wpfui:FluentWindow>